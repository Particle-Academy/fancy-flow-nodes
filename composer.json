{
    "name": "particle-academy/fancy-flow-nodes",
    "description": "The first-party fancy-flow node marketplace — vendored SOURCE, not a published package. `fancy-cli add node --backend=php` copies a node's php/ directory into your app.",
    "keywords": [
        "fancy-flow",
        "workflow",
        "nodes",
        "marketplace",
        "laravel"
    ],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.3",
        "particle-academy/fancy-flow-php": ">=0.8 <2.0"
    },
    "require-dev": {
        "illuminate/support": "^11.0|^12.0|^13.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "particle-academy/fancy-git": ">=0.2 <2.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "suggest": {
        "illuminate/support": "Auto-registers every node's executor and its default host via the service provider."
    },
    "autoload": {
        "psr-4": {
            "FancyFlow\\Nodes\\": "src/",
            "FancyFlow\\Nodes\\UiEffect\\": "nodes/ui-effect/php/",
            "FancyFlow\\Nodes\\GitPrOpen\\": "nodes/git-pr-open/php/",
            "FancyFlow\\Nodes\\GitPrList\\": "nodes/git-pr-list/php/",
            "FancyFlow\\Nodes\\GitPrGet\\": "nodes/git-pr-get/php/",
            "FancyFlow\\Nodes\\GitPrChecks\\": "nodes/git-pr-checks/php/",
            "FancyFlow\\Nodes\\GitPrCompare\\": "nodes/git-pr-compare/php/",
            "FancyFlow\\Nodes\\GitRepo\\": "nodes/git-repo/php/",
            "FancyFlow\\Nodes\\GitStatus\\": "nodes/git-status/php/",
            "FancyFlow\\Nodes\\GitLog\\": "nodes/git-log/php/",
            "FancyFlow\\Nodes\\GitBranches\\": "nodes/git-branches/php/",
            "FancyFlow\\Nodes\\GitDiff\\": "nodes/git-diff/php/",
            "FancyFlow\\Nodes\\GitCheckout\\": "nodes/git-checkout/php/",
            "FancyFlow\\Nodes\\GitPush\\": "nodes/git-push/php/",
            "FancyFlow\\Nodes\\GitPull\\": "nodes/git-pull/php/",
            "FancyFlow\\Nodes\\LlmInput\\": "nodes/llm-input/php/",
            "FancyFlow\\Nodes\\LlmScreen\\": "nodes/llm-screen/php/",
            "FancyFlow\\Nodes\\GitIssueOpen\\": "nodes/git-issue-open/php/",
            "FancyFlow\\Nodes\\GitIssueGet\\": "nodes/git-issue-get/php/",
            "FancyFlow\\Nodes\\GitIssueList\\": "nodes/git-issue-list/php/",
            "FancyFlow\\Nodes\\GitIssueUpdate\\": "nodes/git-issue-update/php/",
            "FancyFlow\\Nodes\\GitIssueComment\\": "nodes/git-issue-comment/php/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FancyFlow\\Nodes\\Tests\\": "tests/php/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
