{
    "name": "particle-academy/fancy-flow-nodes",
    "description": "The first-party fancy-flow node marketplace — the PHP backends. Pairs with the @particle-academy/fancy-flow-nodes npm package, which carries the same nodes' UI.",
    "keywords": ["fancy-flow", "workflow", "nodes", "marketplace", "laravel"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.3",
        "particle-academy/fancy-flow-php": "^0.9"
    },
    "require-dev": {
        "illuminate/support": "^11.0|^12.0|^13.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "suggest": {
        "illuminate/support": "Auto-registers every node's executor and its default host via the service provider."
    },
    "autoload": {
        "psr-4": {
            "FancyFlow\\Nodes\\": "src/",
            "FancyFlow\\Nodes\\UiEffect\\": "nodes/ui-effect/php/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FancyFlow\\Nodes\\Tests\\": "tests/php/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["FancyFlow\\Nodes\\Laravel\\FancyFlowNodesServiceProvider"]
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
